{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "InkIt",
  "version": "0.9.0",
  "identifier": "Yeib.InkIt",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "InkIt",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "CN=A3BEC9C4-FDB6-4E8A-8B23-D67FB5F9DB0D",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "Portable Document Format",
        "description": "InkIt PDF Document",
        "role": "Viewer"
      }
    ]
  }
}
